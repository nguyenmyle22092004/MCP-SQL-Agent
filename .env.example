DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5433/house_price_agent
READONLY_DATABASE_URL=
READONLY_DB_USER=house_price_reader
READONLY_DB_PASSWORD=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=
ANTHROPIC_PROMPT_CACHE=true
PROMPT_VERSION=sql-planner-v2
DECISION_BACKEND=fake
DECISION_MODEL_PATH=decision_layer/artifacts/local_model.json
DECISION_GAZETTEER_PATH=data/gazetteer.json
DECISION_FALSE_ACCEPT_COST=10
DECISION_FALSE_REJECT_COST=1
DECISION_CLARIFICATION_COST=2
DECISION_WRONG_THRESHOLD=0.5
DECISION_ENTITY_MATCH_PROBABILITY=0.02
DECISION_ENTITY_MISMATCH_PROBABILITY=0.98
AGENT_MAX_ITERATIONS=3
AGENT_TIMEOUT_SECONDS=45
AGENT_MAX_TOKENS=12000
AGENT_MAX_COST_USD=0.05
LLM_INPUT_COST_PER_MILLION_USD=3.0
LLM_OUTPUT_COST_PER_MILLION_USD=15.0
SQL_TOOL_TIMEOUT_SECONDS=10
MCP_TOOL_TIMEOUT_SECONDS=12
